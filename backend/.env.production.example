APP_NAME=LFMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.edu
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
# Copy the exact Session Pooler host, username and port from Supabase > Connect.
DB_HOST=YOUR_SUPABASE_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
# File cache is suitable for one application instance. Use a shared cache (for example Redis)
# before scaling to multiple backend instances.
CACHE_STORE=file
QUEUE_CONNECTION=sync
FRONTEND_URL=https://app.example.edu
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only Auth Admin credential. Never prefix with VITE_ or expose to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_USER_TIMEOUT=10
