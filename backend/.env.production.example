APP_NAME=LFMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.edu
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
# Set DB_URL in Render to the Neon pooled connection string for the lfms_runtime role.
# Never use neondb_owner or another database owner for application traffic.
# Keep the real connection string in Render's secret environment variables only.
DB_URL=
DB_SSLMODE=require
# File cache is suitable for one application instance. Use a shared cache (for example Redis)
# before scaling to multiple backend instances.
CACHE_STORE=file
QUEUE_CONNECTION=sync
FRONTEND_URL=https://app.example.edu
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only Auth Admin credential. Never prefix with VITE_ or expose to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_USER_TIMEOUT=10
# 32-byte hex HMAC key matching private.identity_signing_key in Neon.
# Store only as a Render secret environment variable.
LFMS_IDENTITY_HMAC_KEY=
