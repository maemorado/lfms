APP_NAME=LFMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
# Use a local development PostgreSQL database or a dedicated non-production Supabase project.
# Never point routine development/test runs at the production database.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lfms_dev
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
CACHE_STORE=file
QUEUE_CONNECTION=sync
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only key for Supabase Auth Admin operations. Leave empty unless needed.
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_USER_TIMEOUT=10
