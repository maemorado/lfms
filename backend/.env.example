APP_NAME=LFMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
# Shared pooler (session mode). Required on IPv4-only networks because the
# direct Supabase endpoint (db.<ref>.supabase.co) is IPv6-only.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.bwebicixgcnzyqoaccha
DB_PASSWORD=
DB_SSLMODE=require
# Local development uses the file cache so artisan commands do not require a
# database connection. Set CACHE_STORE=database (or redis) in production.
CACHE_STORE=file
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://bwebicixgcnzyqoaccha.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Q1PpH2QbDD324hvUj8MUag_P6ZrC1eE
# Required for admin invitation, account ban/unban and rollback. Keep server-only.
# Obtain a Supabase secret key from Project Settings > API Keys.
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_USER_TIMEOUT=10
