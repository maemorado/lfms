{
  "name": "lfms/backend",
  "type": "project",
  "description": "LFMS Laravel REST API backend",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "requireDev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr4": {
      "App\\": "app/"
    }
  },
  "autoloadDev": {
    "psr4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimizeAutoloader": true,
    "preferredInstall": "dist",
    "sortPackages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}